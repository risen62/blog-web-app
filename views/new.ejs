<link rel="stylesheet" href="/styles/styles.css">
<h1>Enter the title of your blog</h1>
<form action="/" method="post" class="new-post-form" >
  <label for="title" ></label>
  <input
    type="text"
    id="title"
    name="titlename"
    placeholder="Enter your blog title"
  />

  <textarea id="contentid" name = "content"></textarea>
  <button  class = "new-post-button" type="submit">Submit</button>
</form>
